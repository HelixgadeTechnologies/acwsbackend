# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production

# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/boilerplate_db
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─────────────────────────────────────────────
#  Authentication
# ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d             # e.g. 15m | 1h | 7d

# ─────────────────────────────────────────────
#  Security
# ─────────────────────────────────────────────
BCRYPT_ROUNDS=12              # Higher = slower hash (recommended: 10-14)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
