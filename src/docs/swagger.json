{
  "openapi": "3.0.3",
  "info": {
    "title": "ACWS 2027 (African Caribbean Wedding Show) Backend API",
    "version": "1.0.0",
    "description": "Official REST API for ACWS 2027 vendor registration, admin management dashboard, attendee tracking, and QR code digital business cards.",
    "contact": {
      "name": "ACWS Technology Team",
      "email": "admin@acws.co.uk"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "API v1 Base URL"
    },
    {
      "url": "/",
      "description": "Root Server URL"
    }
  ],
  "tags": [
    {
      "name": "Admin Auth",
      "description": "Administrator login and profile verification"
    },
    {
      "name": "Admin Vendors",
      "description": "Protected exhibitor management, metrics, status updates, and search"
    },
    {
      "name": "Admin Attendees",
      "description": "Protected attendee list, batch import, and on-site check-in"
    },
    {
      "name": "Public Vendors",
      "description": "Public exhibitor registration and unauthenticated profile cards"
    },
    {
      "name": "Public Attendees",
      "description": "Public ticket registration and payment initiation for attendees"
    },
    {
      "name": "Payments",
      "description": "Stripe checkout session verification and asynchronous webhook fulfillment"
    },
    {
      "name": "System",
      "description": "Server health status and root discovery"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Root landing info",
        "description": "Returns API metadata and documentation links.",
        "servers": [{ "url": "/" }],
        "responses": {
          "200": { "description": "API status online" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check API health",
        "description": "Returns current server health and timestamp.",
        "servers": [{ "url": "/" }],
        "responses": {
          "200": { "description": "Server is healthy" }
        }
      }
    },
    "/admin/login": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Administrator Login",
        "description": "Authenticates an administrator with email and password, returning user details and JWT Bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin authenticated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAuthResponse"
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" },
          "403": { "description": "Access denied. Administrator privileges required." }
        }
      }
    },
    "/admin/me": {
      "get": {
        "tags": ["Admin Auth"],
        "summary": "Get current Admin Profile",
        "description": "Returns authenticated administrator details.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current admin profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": { "$ref": "#/components/schemas/AdminUser" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Authentication required" }
        }
      }
    },
    "/admin/vendors/stats": {
      "get": {
        "tags": ["Admin Vendors"],
        "summary": "Get vendor breakdown statistics",
        "description": "Returns total count, status breakdown, and tier counts for dashboard metrics.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Vendor statistics retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorStatsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/vendors": {
      "get": {
        "tags": ["Admin Vendors"],
        "summary": "List paginated vendors with filters and search",
        "description": "Search across business name, contact person, email, and reference code with status or category filters.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "approved", "waitlisted", "rejected"] } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "paymentTier", "in": "query", "schema": { "type": "string", "enum": ["standard", "premium", "catwalk", "executive"] } }
        ],
        "responses": {
          "200": {
            "description": "Vendors retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "vendors": { "type": "array", "items": { "$ref": "#/components/schemas/Vendor" } },
                        "total": { "type": "integer", "example": 54 },
                        "totalPages": { "type": "integer", "example": 6 },
                        "currentPage": { "type": "integer", "example": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/vendors/{id}": {
      "get": {
        "tags": ["Admin Vendors"],
        "summary": "Get vendor by ID or RefCode",
        "description": "Retrieve full vendor submission breakdown by MongoDB _id or reference code (e.g. ACWS-2027-VND-XXXX).",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "MongoDB ObjectId or Vendor refCode" }
        ],
        "responses": {
          "200": {
            "description": "Vendor details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Vendor" }
                  }
                }
              }
            }
          },
          "404": { "description": "Vendor not found" }
        }
      }
    },
    "/admin/vendors/{id}/status": {
      "patch": {
        "tags": ["Admin Vendors"],
        "summary": "Update vendor review status and notes",
        "description": "Change status between pending, approved, waitlisted, and rejected, and attach curator review notes.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "MongoDB ObjectId or Vendor refCode" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateVendorStatusInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Vendor" }
                  }
                }
              }
            }
          },
          "404": { "description": "Vendor not found" }
        }
      }
    },
    "/admin/attendees": {
      "get": {
        "tags": ["Admin Attendees"],
        "summary": "List paginated attendees with search & filters",
        "description": "Search by attendee name, email, phone, or refCode, and filter by ticket type or check-in status.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "ticketType", "in": "query", "schema": { "type": "string", "enum": ["standard", "vip", "catwalk-exclusive"] } },
          { "name": "checkedIn", "in": "query", "schema": { "type": "string", "enum": ["true", "false"] } }
        ],
        "responses": {
          "200": {
            "description": "Attendees list retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "attendees": { "type": "array", "items": { "$ref": "#/components/schemas/Attendee" } },
                        "total": { "type": "integer", "example": 120 },
                        "page": { "type": "integer", "example": 1 },
                        "totalPages": { "type": "integer", "example": 6 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/attendees/{id}/checkin": {
      "patch": {
        "tags": ["Admin Attendees"],
        "summary": "Check-in or toggle attendee arrival",
        "description": "Toggles or explicitly sets checkedIn status and records checkedInAt timestamp by _id or refCode.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "MongoDB ObjectId or Attendee refCode" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "checkedIn": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attendee check-in status updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": { "$ref": "#/components/schemas/Attendee" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/attendees/batch": {
      "post": {
        "tags": ["Admin Attendees"],
        "summary": "Batch import attendees",
        "description": "Import multiple attendee records at once (from CSV or external ticket platforms).",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchAttendeesInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Attendees imported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "count": { "type": "integer", "example": 25 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendors": {
      "post": {
        "tags": ["Public Vendors"],
        "summary": "Register as an ACWS 2027 Exhibitor/Vendor",
        "description": "Public registration form submission. Generates unique reference code and downloadable QR code.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVendorInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vendor registration submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "vendor": { "$ref": "#/components/schemas/Vendor" },
                        "refCode": { "type": "string", "example": "ACWS-2027-VND-8X4K2" },
                        "qrCode": { "type": "string", "example": "data:image/png;base64,..." },
                        "publicProfileUrl": { "type": "string" },
                        "checkoutUrl": { "type": "string", "nullable": true, "example": "https://checkout.stripe.com/c/pay/cs_test_..." },
                        "sessionId": { "type": "string", "nullable": true, "example": "cs_test_..." }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendors/public/{refCode}": {
      "get": {
        "tags": ["Public Vendors"],
        "summary": "Get public exhibitor details by RefCode",
        "description": "Unauthenticated JSON endpoint returning brand information (businessName, website, instagram, phone, email).",
        "parameters": [
          { "name": "refCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Public brand profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "refCode": { "type": "string", "example": "ACWS-2027-VND-8X4K2" },
                        "businessName": { "type": "string", "example": "Royal Elegance Bridal" },
                        "category": { "type": "string", "example": "Bridal & Groom Attire" },
                        "website": { "type": "string", "example": "https://royalelegance.co.uk" },
                        "instagram": { "type": "string", "example": "@royalelegance_uk" },
                        "phone": { "type": "string", "example": "+44 7911 123456" },
                        "email": { "type": "string", "example": "contact@royalelegance.co.uk" },
                        "baseLocation": { "type": "string", "example": "London, United Kingdom" },
                        "qrCode": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vendors/public/{refCode}/card": {
      "get": {
        "tags": ["Public Vendors"],
        "summary": "View mobile-friendly Digital Business Card",
        "description": "Direct unauthenticated HTML page rendered for smartphones when scanning the vendor's QR code.",
        "parameters": [
          { "name": "refCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "HTML digital card" }
        }
      }
    },
    "/attendees": {
      "post": {
        "tags": ["Public Attendees"],
        "summary": "Register as an ACWS 2027 Attendee & trigger Stripe payment",
        "description": "Registers an attendee, calculates ticket price, and returns Stripe Checkout URL for full-page payment redirection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAttendeeInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Attendee registration initiated or confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "attendee": { "$ref": "#/components/schemas/Attendee" },
                        "refCode": { "type": "string", "example": "ACWS-2027-ATT-48F2" },
                        "qrCode": { "type": "string", "example": "data:image/png;base64,..." },
                        "publicPassUrl": { "type": "string", "example": "http://localhost:5000/api/v1/attendees/public/ACWS-2027-ATT-48F2/pass" },
                        "checkoutUrl": { "type": "string", "nullable": true, "example": "https://checkout.stripe.com/c/pay/cs_test_..." },
                        "sessionId": { "type": "string", "nullable": true, "example": "cs_test_..." }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/attendees/public/{refCode}": {
      "get": {
        "tags": ["Public Attendees"],
        "summary": "Get public attendee admission details by RefCode",
        "description": "Unauthenticated JSON endpoint returning ticket type, payment status, fast track status, and check-in validation.",
        "parameters": [
          { "name": "refCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Public attendee pass data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "refCode": { "type": "string", "example": "ACWS-2027-ATT-48F2" },
                        "fullName": { "type": "string", "example": "Amara Diallo" },
                        "ticketType": { "type": "string", "example": "VIP Pass" },
                        "ticketPrice": { "type": "string", "example": "£40" },
                        "paymentStatus": { "type": "string", "example": "paid" },
                        "fastTrackPass": { "type": "boolean", "example": true },
                        "checkedIn": { "type": "boolean", "example": false },
                        "qrCode": { "type": "string" },
                        "publicPassUrl": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Attendee not found" }
        }
      }
    },
    "/attendees/public/{refCode}/pass": {
      "get": {
        "tags": ["Public Attendees"],
        "summary": "Direct HTML Mobile Admission Ticket Pass",
        "description": "Direct unauthenticated HTML page rendered when scanning the attendee's QR code on smartphones.",
        "parameters": [
          { "name": "refCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "HTML mobile admission pass" }
        }
      }
    },
    "/scan/{refCode}": {
      "get": {
        "tags": ["Public Attendees", "Public Vendors"],
        "summary": "Universal unauthenticated QR code scan endpoint",
        "description": "Automatically detects whether the scanned reference code belongs to an Attendee pass or a Vendor exhibitor card and renders HTML for browsers or JSON for API clients.",
        "parameters": [
          { "name": "refCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Pass HTML or profile JSON" }
        }
      }
    },
    "/payments/verify-session/{sessionId}": {
      "get": {
        "tags": ["Payments"],
        "summary": "Verify checkout session status & registration details upon return navigation",
        "description": "Called by frontend platform when navigating back from Stripe Checkout (success URL). Returns confirmed ticket pass or exhibitor profile.",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "The Stripe Checkout Session ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment and registration status verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "type": { "type": "string", "enum": ["attendee", "vendor"], "example": "attendee" },
                        "refCode": { "type": "string", "example": "ACWS-2027-ATT-48F2" },
                        "paymentStatus": { "type": "string", "example": "paid" },
                        "pricePaid": { "type": "number", "example": 20 }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Session not found"
          }
        }
      }
    },
    "/payments/webhook": {
      "post": {
        "tags": ["Payments"],
        "summary": "Stripe Webhook fulfillment endpoint",
        "description": "Receives asynchronous events directly from Stripe servers (e.g. checkout.session.completed). Cryptographically validated via Stripe-Signature header and raw buffer body.",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook received and processed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "received": { "type": "boolean", "example": true }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Signature validation failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT token obtained from POST /api/v1/admin/login"
      }
    },
    "schemas": {
      "AdminLoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "admin@acws.co.uk" },
          "password": { "type": "string", "example": "Password123!" }
        }
      },
      "AdminUser": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6ade356fd3fbaaf07646d485" },
          "name": { "type": "string", "example": "ACWS Executive Curator" },
          "email": { "type": "string", "example": "admin@acws.co.uk" },
          "role": { "type": "string", "enum": ["admin", "superadmin", "curator"], "example": "superadmin" }
        }
      },
      "AdminAuthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Admin authenticated successfully" },
          "data": {
            "type": "object",
            "properties": {
              "user": { "$ref": "#/components/schemas/AdminUser" },
              "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
            }
          }
        }
      },
      "Vendor": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6ade356fd3fbaaf07646d485" },
          "refCode": { "type": "string", "example": "ACWS-2027-VND-8X4K2" },
          "businessName": { "type": "string", "example": "Royal Elegance Bridal" },
          "category": { "type": "string", "example": "Attire & Bridal Wear" },
          "contactName": { "type": "string", "example": "Amara Okafor" },
          "contactPerson": { "type": "string", "example": "Amara Okafor" },
          "email": { "type": "string", "example": "amara@royalelegance.co.uk" },
          "phone": { "type": "string", "example": "+44 7911 123456" },
          "website": { "type": "string", "example": "https://royalelegance.co.uk" },
          "instagram": { "type": "string", "example": "@royalelegance_uk" },
          "baseLocation": { "type": "string", "example": "London, Greater London" },
          "paymentTier": { "type": "string", "enum": ["standard", "premium", "catwalk", "executive"], "example": "premium" },
          "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "exempt"], "example": "paid" },
          "pricePaid": { "type": "number", "example": 450 },
          "stripeSessionId": { "type": "string", "nullable": true },
          "stripePaymentIntentId": { "type": "string", "nullable": true },
          "paidAt": { "type": "string", "format": "date-time", "nullable": true },
          "status": { "type": "string", "enum": ["pending", "approved", "waitlisted", "rejected"], "example": "pending" },
          "weddingVolume": { "type": "string", "example": "25-40/yr" },
          "typicalSpend": { "type": "string", "example": "£6,000+" },
          "serviceAreas": { "type": "array", "items": { "type": "string" }, "example": ["Greater London", "Nationwide UK"] },
